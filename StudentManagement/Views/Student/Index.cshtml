@model IEnumerable<StudentManagement.Models.Student>

@{
    ViewData["Title"] = "Student Dashboard";
}

<div class="dashboard-header">

    <div>

        <h2>Student Management</h2>

        <p>
            Manage students, courses and records easily.
        </p>

    </div>

    <a asp-action="Create" class="btn btn-add">

        <i class="bi bi-plus-circle"></i>

        Add Student

    </a>

</div>
<div class="row mt-4">

    <div class="col-md-3">

        <div class="dashboard-card">

            <div>

                <h6>Total Students</h6>

                <h2>@ViewBag.TotalStudents</h2>

            </div>

            <div class="card-icon">

                <i class="bi bi-people-fill"></i>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="dashboard-card">

            <div>

                <h6>Courses</h6>

                <h2>@ViewBag.TotalCourses</h2>

            </div>

            <div class="card-icon">

                <i class="bi bi-book-half"></i>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="dashboard-card">

            <div>

                <h6>Active</h6>

                <h2>@ViewBag.ActiveStudents</h2>

            </div>

            <div class="card-icon">

                <i class="bi bi-check-circle-fill"></i>

            </div>

        </div>

    </div>

    <div class="col-md-3">

        <div class="dashboard-card">

            <div>

                <h6>Average Age</h6>

                <h2>21</h2>

            </div>

            <div class="card-icon">

                <i class="bi bi-calendar2"></i>

            </div>

        </div>

    </div>

</div>
<div class="search-box">

    <i class="bi bi-search"></i>

    <input type="text"
           placeholder="Search student..." />

</div>
<div class="table-card">

    <table class="table align-middle">

        <thead>

            <tr>

                <th>Student</th>

                <th>Course</th>

                <th>Email</th>

                <th>Age</th>

                <th>Status</th>

                <th>Action</th>

            </tr>

        </thead>

        <tbody>

            @foreach (var item in Model)
            {

                <tr>

                    <td>

                        <div class="student-info">

                            <div class="avatar">

                                @item.Name.Substring(0, 1)

                            </div>

                            <div>

                                <strong>@item.Name</strong>

                            </div>

                        </div>

                    </td>

                    <td>

                        <span class="badge bg-primary">

                            @item.Course

                        </span>

                    </td>

                    <td>

                        @item.Email

                    </td>

                    <td>

                        @item.Age

                    </td>

                    <td>

                        <span class="badge bg-success">

                            Active

                        </span>

                    </td>

                    <td>

                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-warning btn-sm">

                            <i class="bi bi-pencil"></i>

                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-danger btn-sm">

                            <i class="bi bi-trash"></i>

                        </a>
                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-info btn-sm">

                            <i class="bi bi-eye-fill"></i>

                        </a>

                    </td>

                </tr>

            }

        </tbody>

    </table>

</div>
