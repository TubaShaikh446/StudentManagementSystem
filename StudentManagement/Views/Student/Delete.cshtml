@model StudentManagement.Models.Student

@{
    ViewData["Title"] = "Delete Student";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="delete-card">

                <!-- Icon -->
                <div class="text-center">

                    <div class="delete-icon">

                        <i class="bi bi-exclamation-triangle-fill"></i>

                    </div>

                    <h2 class="mt-4 fw-bold text-danger">

                        Delete Student

                    </h2>

                    <p class="text-muted">

                        This action cannot be undone. Please confirm before deleting this student.

                    </p>

                </div>

                <hr class="my-4" />

                <!-- Student Details -->

                <div class="student-info">

                    <div class="avatar">

                        @Model.Name.Substring(0, 1).ToUpper()

                    </div>

                    <div>

                        <h4 class="mb-1">@Model.Name</h4>

                        <span class="badge bg-primary">
                            @Model.Course
                        </span>

                    </div>

                </div>

                <div class="row mt-4">

                    <div class="col-md-6 mb-3">

                        <label>Email</label>

                        <div class="info-box">

                            <i class="bi bi-envelope-fill"></i>

                            @Model.Email

                        </div>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label>Age</label>

                        <div class="info-box">

                            <i class="bi bi-calendar-event-fill"></i>

                            @Model.Age Years

                        </div>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label>Course</label>

                        <div class="info-box">

                            <i class="bi bi-book-fill"></i>

                            @Model.Course

                        </div>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label>Status</label>

                        <div class="info-box text-success">

                            <i class="bi bi-check-circle-fill"></i>

                            Active Student

                        </div>

                    </div>

                </div>

                <form asp-action="Delete">

                    <input asp-for="Id" type="hidden" />

                    <div class="d-flex justify-content-end gap-3 mt-4">

                        <a asp-action="Index"
                           class="btn btn-light px-4">

                            <i class="bi bi-arrow-left"></i>

                            Cancel

                        </a>

                        <button type="submit"
                                class="btn btn-danger px-4">

                            <i class="bi bi-trash-fill"></i>

                            Delete Student

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>