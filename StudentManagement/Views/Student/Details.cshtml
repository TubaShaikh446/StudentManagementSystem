@model StudentManagement.Models.Student

@{
    ViewData["Title"] = "Student Details";
}

<div class="container-fluid mt-4">

    <div class="row">

        <!-- Left Card -->

        <div class="col-lg-4">

            <div class="profile-box">

                <div class="profile-avatar">

                    @Model.Name.Substring(0, 1).ToUpper()

                </div>

                <h3>@Model.Name</h3>

                <p>@Model.Course</p>

                <span class="status-badge">

                    <i class="bi bi-check-circle-fill"></i>

                    Active Student

                </span>

                <hr>

                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-warning w-100 mb-2">

                    <i class="bi bi-pencil-square"></i>

                    Edit Student

                </a>

                <a asp-action="Delete"
                   asp-route-id="@Model.Id"
                   class="btn btn-danger w-100 mb-2">

                    <i class="bi bi-trash-fill"></i>

                    Delete Student

                </a>

                <a asp-action="Index"
                   class="btn btn-light w-100">

                    <i class="bi bi-arrow-left"></i>

                    Back

                </a>

            </div>

        </div>

        <!-- Right -->

        <div class="col-lg-8">

            <div class="details-box">

                <h3 class="mb-4">

                    Student Information

                </h3>

                <div class="info-row">

                    <span>Email</span>

                    <strong>@Model.Email</strong>

                </div>

                <div class="info-row">

                    <span>Phone</span>

                    <strong>@Model.Phone</strong>

                </div>

                <div class="info-row">

                    <span>Age</span>

                    <strong>@Model.Age Years</strong>

                </div>

                <div class="info-row">

                    <span>Course</span>

                    <strong>@Model.Course</strong>

                </div>

                <div class="info-row">

                    <span>Gender</span>

                    <strong>@Model.Gender</strong>

                </div>

                <div class="info-row">

                    <span>Address</span>

                    <strong>@Model.Address</strong>

                </div>

            </div>

        </div>

    </div>

</div>