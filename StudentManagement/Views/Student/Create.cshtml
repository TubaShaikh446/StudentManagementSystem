@model StudentManagement.Models.Student

@{
    ViewData["Title"] = "Add Student";
}

<div class="container mt-4">

    <div class="create-card">

        <div class="form-header">
            <h2>
                <i class="bi bi-person-plus-fill text-primary"></i>
                Add New Student
            </h2>
            <p class="text-muted">
                Fill in the student details below.
            </p>
        </div>

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">

                <!-- Name -->
                <div class="col-md-6 mb-3">
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name" class="form-control custom-input" placeholder="Enter full name" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <!-- Email -->
                <div class="col-md-6 mb-3">
                    <label asp-for="Email" class="form-label fw-semibold"></label>
                    <input asp-for="Email" class="form-control custom-input" placeholder="example@gmail.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <!-- Age -->
                <div class="col-md-6 mb-3">
                    <label asp-for="Age" class="form-label fw-semibold"></label>
                    <input asp-for="Age" class="form-control custom-input" />
                    <span asp-validation-for="Age" class="text-danger"></span>
                </div>

                <!-- Course -->
                <div class="col-md-6 mb-3">

                    <label asp-for="Course" class="form-label fw-semibold"></label>

                    <select asp-for="Course" class="form-select custom-input">

                        <option value="">
                            Select Course
                        </option>

                        @foreach (var course in ViewBag.Courses)
                        {
                            <option value="@course.CourseName">
                                @course.CourseName
                            </option>
                        }

                    </select>

                    <span asp-validation-for="Course" class="text-danger"></span>

                </div>

                <!-- Phone -->
                <div class="col-md-6 mb-3">
                    <label asp-for="Phone" class="form-label fw-semibold"></label>
                    <input asp-for="Phone" class="form-control custom-input" placeholder="9876543210" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>

                <!-- Gender -->
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold d-block">Gender</label>

                    <div class="form-check form-check-inline">
                        <input asp-for="Gender"
                               class="form-check-input"
                               type="radio"
                               value="Male" />
                        <label class="form-check-label">Male</label>
                    </div>

                    <div class="form-check form-check-inline">
                        <input asp-for="Gender"
                               class="form-check-input"
                               type="radio"
                               value="Female" />
                        <label class="form-check-label">Female</label>
                    </div>

                    <span asp-validation-for="Gender" class="text-danger"></span>
                </div>

                <!-- Address -->
                <div class="col-12 mb-3">
                    <label asp-for="Address" class="form-label fw-semibold"></label>
                    <textarea asp-for="Address"
                              class="form-control"
                              rows="4"
                              placeholder="Enter address"></textarea>

                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

            </div>

            <div class="d-flex justify-content-end mt-4">

                <a asp-action="Index" class="btn btn-outline-secondary me-2">
                    Cancel
                </a>

                <button type="submit" class="btn btn-save">
                    <i class="bi bi-check-circle-fill"></i>
                    Save Student
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}