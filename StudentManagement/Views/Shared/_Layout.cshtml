<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - StudentHub</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

</head>

<body>

    <!-- Sidebar -->
    <div class="sidebar">

        <div class="logo">
            <i class="bi bi-mortarboard-fill"></i>
            StudentHub
        </div>

        <ul>

            <a asp-controller="Student"
               asp-action="Dashboard">

                <i class="bi bi-house-door"></i>

                Dashboard

            </a>

            <li>
                <a asp-controller="Student" asp-action="Index">
                    <i class="bi bi-people-fill"></i>
                    Students
                </a>
            </li>

            <li>

                <a asp-controller="Course"
                   asp-action="Index">

                    <i class="bi bi-book-fill"></i>

                    Courses

                </a>

            </li>

            <li>
                <a href="#">
                    <i class="bi bi-bar-chart-fill"></i>
                    Reports
                </a>
            </li>

        </ul>

    </div>

    <!-- Main Content -->
    <div class="main">

        <!-- Topbar -->
        <div class="topbar">

            <h4 class="mb-0 fw-bold">
                @ViewData["Title"]
            </h4>

            <div class="d-flex align-items-center">

                <i class="bi bi-search fs-5 me-4"></i>

                <i class="bi bi-bell fs-5 me-4"></i>

                <i class="bi bi-person-circle fs-3"></i>

            </div>

        </div>

        <!-- Page Content -->
        <div class="content">

            @RenderBody()

        </div>

    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- jQuery Validation -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.20.0/jquery.validate.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

   
    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>