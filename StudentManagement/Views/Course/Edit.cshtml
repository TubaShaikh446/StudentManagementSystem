@model StudentManagement.Models.Course

@{
    ViewData["Title"] = "Edit Course";
}

<div class="container-fluid">

    <div class="create-card">

        <div class="form-header">

            <h2>
                <i class="bi bi-pencil-square text-warning"></i>
                Edit Course
            </h2>

            <p class="text-muted">
                Update course information.
            </p>

        </div>

        <form asp-action="Edit" method="post">

            <input asp-for="Id" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="row">

                <!-- Course Name -->

                <div class="col-md-6 mb-4">

                    <label asp-for="CourseName"
                           class="form-label fw-semibold"></label>

                    <input asp-for="CourseName"
                           class="form-control custom-input" />

                    <span asp-validation-for="CourseName"
                          class="text-danger"></span>

                </div>

                <!-- Department -->

                <div class="col-md-6 mb-4">

                    <label asp-for="Department"
                           class="form-label fw-semibold"></label>

                    <select asp-for="Department"
                            class="form-select custom-input">

                        <option>Information Technology</option>
                        <option>Computer Science</option>
                        <option>Commerce</option>
                        <option>Management</option>
                        <option>Arts</option>

                    </select>

                    <span asp-validation-for="Department"
                          class="text-danger"></span>

                </div>

                <!-- Duration -->

                <div class="col-md-6 mb-4">

                    <label asp-for="Duration"
                           class="form-label fw-semibold"></label>

                    <input asp-for="Duration"
                           class="form-control custom-input" />

                    <span asp-validation-for="Duration"
                          class="text-danger"></span>

                </div>

                <!-- Fees -->

                <div class="col-md-6 mb-4">

                    <label asp-for="Fees"
                           class="form-label fw-semibold"></label>

                    <input asp-for="Fees"
                           class="form-control custom-input" />

                    <span asp-validation-for="Fees"
                          class="text-danger"></span>

                </div>

                <!-- Status -->

                <div class="col-md-12 mb-4">

                    <label class="form-label fw-semibold">
                        Status
                    </label>

                    <div class="form-check form-switch">

                        <input asp-for="IsActive"
                               class="form-check-input" />

                        <label class="form-check-label">
                            Active Course
                        </label>

                    </div>

                </div>

            </div>

            <div class="text-end">

                <a asp-action="Index"
                   class="btn btn-outline-secondary me-2">

                    <i class="bi bi-arrow-left"></i>

                    Back

                </a>

                <button type="submit"
                        class="btn btn-warning text-white">

                    <i class="bi bi-check-circle-fill"></i>

                    Update Course

                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}